# ─── Required ────────────────────────────────────────────────────────────────

# Absolute path to the projects/ runtime folder on the host.
# Docker mounts this into backend and executor containers.
PROJECTS_DIR=./projects

# PostgreSQL
DATABASE_URL=postgres://hive:hive@postgres:5432/hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=hive

# Redis
REDIS_URL=redis://redis:6379

# Internal executor service URL (backend → executor)
EXECUTOR_URL=http://executor:3001

# ─── Skill Import Directories ────────────────────────────────────────────────
# Comma-separated paths to directories containing SKILL.md files.
# These will be scanned and imported at startup.
# Leave empty to disable automatic import.

# OpenCode skills from global ~/.agents/skills
OPENCODE_SKILLS_DIR=

# Multica workspace skills
MULTICA_SKILLS_DIR=

# Additional custom skill directories (comma-separated)
CUSTOM_SKILLS_DIRS=

# ─── Optional: LLM providers ─────────────────────────────────────────────────
# These can also be set per-provider in the UI (Settings → Providers).
# Environment values serve as defaults.

# MLX LM — local Apple Silicon inference server
# Start with: mlx_lm.server --model <model>
MLX_LM_BASE_URL=http://host.docker.internal:8080

# Google Gemini
# Uses the OpenAI-compatible endpoint automatically.
GEMINI_API_KEY=

# AWS — profile name from ~/.aws/config for SSO
# ~/.aws is mounted read-only into the backend container.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Concurrency limits for parallel running agents/stories to prevent local OOMs
MAX_CONCURRENT_AGENTS=2

# ─── Backend ─────────────────────────────────────────────────────────────────
RUST_LOG=hive_api=debug,info
# Absolute path inside the container where projects are stored
CONTAINER_PROJECTS_DIR=/app/projects
